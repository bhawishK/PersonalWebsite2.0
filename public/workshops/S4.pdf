/T (// 3d\) Update the button's ARIA state  button.setAttribute\('aria-expanded', nextExpanded\);  // 3e\) Show or hide the panel using the 'hidden' property  if \(nextExpanded === 'true'\) {  // Opening  panel.hidden = false;  // Add a class to let CSS animate if you want, but it's optional  addClass\(panel, 'is-open'\);  } else {  // Closing  removeClass\(panel, 'is-open'\);  // Hide the panel directly \(keeps screen readers from announcing it\)  panel.hidden = true;  }  })
/E (// 3d\) Update the button's ARIA state  button.setAttribute\('aria-expanded', nextExpanded\);  // 3e\) Show or hide the panel using the 'hidden' property  if \(nextExpanded === 'true'\) {  // Opening  panel.hidden = false;  // Add a class to let CSS animate if you want, but it's optional  addClass\(panel, 'is-open'\);  } else {  // Closing  removeClass\(panel, 'is-open'\);  // Hide the panel directly \(keeps screen readers from announcing it\)  panel.hidden = true;  }  })
/Pg 30 0 R
/K [17]
>>
endobj
